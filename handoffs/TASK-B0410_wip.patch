n}\n\n.tagline-main {\n  font-size: 6.5pt;\n  font-weight: bold;\n  line-height: 1.5;\n}\n\n.tagline-sub {\n  font-size: 5.5pt;\n  font-weight: normal;\n  line-height: 1.5;\n}\n\n/* \u2550\u2550 SEPARATORS \u2550\u2550\n   \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629: \u062e\u0637\u0648\u0637 dashed \u0648\u0627\u0636\u062d\u0629\n   \u00f72 \u2192 \u0646\u0628\u0642\u064a\u0647\u0627 1px \u0644\u0623\u0646\u0647\u0627 \u0644\u0627 \u062a\u062a\u062c\u0632\u0623\n*/\n.sep-dash {\n  border: none;\n  border-top: 1px dashed #000;\n  margin: 1.5mm 0;\n}\n.sep-solid {\n  border: none;\n  border-top: 1px solid #000;\n  margin: 1mm 0;\n}\n.sep-double {\n  border-top: 2px double #000;\n  margin: 1mm 0;\n}\n\n/* \u2550\u2550 META BLOCK \u2550\u2550\n   label width \u0623\u0635\u0644\u064a ~90px \u2192 \u00f72 \u2248 4.5mm \u2192 \u0646\u0633\u062a\u062e\u062f\u0645 16mm \u0644\u0645\u0631\u0627\u0639\u0627\u0629 \u0627\u0644\u062e\u0637 \u0627\u0644\u0635\u063a\u064a\u0631\n*/\n.meta-block {\n  width: 100%;\n  font-size: 6pt;\n  line-height: 1.7;\n}\n\n.meta-row {\n  display: flex;\n  width: 100%;\n}\n\n.meta-label {\n  font-weight: bold;\n  width: 16mm;\n  flex-shrink: 0;\n  white-space: nowrap;\n}\n\n.meta-colon {\n  width: 3mm;\n  flex-shrink: 0;\n  text-align: center;\n}\n\n.meta-value {\n  flex: 1;\n  word-break: break-word;\n  overflow-wrap: break-word;\n}\n\n.meta-value.rtl {\n  direction: rtl;\n  text-align: right;\n}\n\n/* \u2550\u2550 ITEMS TABLE \u2550\u2550\n   \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0639\u0631\u0636 ~740px \u062f\u0627\u062e\u0644\u064a:\n   #    : ~40px  \u2192 \u00f72 \u2248 2mm  \u2192 4mm\n   DESC : ~320px \u2192 \u00f72 \u2248 15mm \u2192 22mm\n   QTY  : ~80px  \u2192 \u00f72 \u2248 4mm  \u2192 7mm\n   PRICE: ~130px \u2192 \u00f72 \u2248 6mm  \u2192 11mm\n   TOTAL: ~130px \u2192 \u00f72 \u2248 6mm  \u2192 11mm\n   \u0645\u062c\u0645\u0648\u0639: 55mm \u062f\u0627\u062e\u0644 padding 2.5mm*2=5mm \u2192 70-5=65mm \u2713\n*/\n.items-table {\n  width: 65mm;\n  border-collapse: collapse;\n  table-layout: fixed;\n}\n\n.items-table thead th {\n  font-weight: bold;\n  font-size: 6pt;\n  padding: 1mm 0.4mm;\n  border-top: 1px dashed #000;\n  border-bottom: 1px dashed #000;\n  text-align: left;\n}\n\n.items-table tbody td {\n  font-size: 5.5pt;\n  padding: 0.8mm 0.4mm;\n  vertical-align: top;\n  overflow-wrap: break-word;\n  word-break: break-word;\n}\n\n.col-no    { width: 4mm;  }\n.col-desc  { width: 22mm; }\n.col-qty   { width: 7mm;  text-align: center; }\n.col-price { width: 11mm; text-align: right;  }\n.col-total { width: 11mm; text-align: right;  }\n\n.items-table thead th.col-qty   { text-align: center; }\n.items-table thead th.col-price { text-align: right;  }\n.items-table thead th.col-total { text-align: right;  }\n\n/* \u2550\u2550 TOTALS \u2550\u2550 */\n.totals-block {\n  width: 100%;\n  font-size: 6pt;\n  line-height: 1.75;\n}\n\n.totals-row {\n  display: flex;\n  justify-content: space-between;\n}\n\n.totals-row .t-label { font-weight: bold; }\n.totals-row .t-value { text-align: right; min-width: 16mm; }\n\n/* \u2550\u2550 GRAND TOTAL \u2550\u2550\n   \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 TOTAL \u0628\u062e\u0637 \u0643\u0628\u064a\u0631 ~22px \u2192 \u00f72 \u2248 8pt\n*/\n.grand-total-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 8.5pt;\n  font-weight: bold;\n  padding: 0.8mm 0;\n}\n\n/* \u2550\u2550 ALERT BOX \u2550\u2550 */\n.alert-box {\n  border: none;\n  border-top: 1px dashed #000;\n  border-bottom: 1px dashed #000;\n  padding: 0.8mm 0;\n  margin: 1mm 0;\n  font-size: 4.8pt;\n  font-weight: bold;\n  line-height: 1.5;\n  white-space: nowrap;\n  text-align: right;\n  direction: rtl;\n  line-height: 1.3;\n  white-space: normal;\n  overflow: hidden;\n}\n\n/* \u2550\u2550 NOTES \u2550\u2550 */\n.notes-section {\n  border: none;\n  border-top: 1px dashed #888;\n  border-bottom: 1px dashed #888;\n  margin-bottom: 1.5mm;\n}\n\n.notes-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.8mm 1.5mm;\n  border-bottom: 1px solid #ccc;\n  direction: rtl;\n}\n\n.notes-label-ar   { font-weight: bold; font-size: 6pt; }\n.notes-placeholder { font-size: 6pt; color: #555; direction: ltr; }\n\n.notes-body {\n  padding: 1mm 1.5mm;\n  min-height: 5mm;\n  font-size: 6pt;\n  direction: rtl;\n  text-align: right;\n}\n\n/* \u2550\u2550 USER INFO \u2550\u2550 */\n.user-info-row {\n  text-align: right;\n  direction: rtl;\n  font-size: 6pt;\n  margin-bottom: 1.5mm;\n  line-height: 1.6;\n}\n\n/* \u2550\u2550 QR SECTION \u2550\u2550 */\n.qr-section {\n  width: 100%;\n  margin: 1mm 0;\n}\n\n.qr-item {\n  border: none;\n  border-top: 1px dashed #888;\n  border-bottom: 1px dashed #888;\n  padding: 1mm;\n  margin-bottom: 1.5mm;\n  display: flex;\n  flex-direction: row-reverse;\n  align-items: center;\n  gap: 1.5mm;\n}\n\n.qr-item-text {\n  flex: 1;\n  direction: rtl;\n  text-align: right;\n  min-width: 0;\n  overflow: hidden;\n}\n\n.qr-item-title {\n  font-size: 5pt;\n  font-weight: bold;\n  margin-bottom: 0.5mm;\n  line-height: 1.3;\n}\n\n.qr-item-desc {\n  font-size: 4.2pt;\n  line-height: 1.4;\n  color: #333;\n}\n\n.qr-img-box {\n  width: 13mm;\n  height: 13mm;\n  border: 1px dashed #aaa;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 4pt;\n  color:#5b6472;\n  text-align: center;\n}\n\n/* \u2550\u2550 MANAGEMENT \u2550\u2550 */\n.management-row {\n  text-align: center;\n  font-size: 3pt;\n  direction: rtl;\n  border-top: 1px solid #ccc;\n  padding-top: 1.2mm;\n  margin-top: 1mm;\n  line-height: 1.5;\n  overflow: hidden;\n}\n\n/* \u2550\u2550 FOOTER \u2550\u2550 */\n.footer-thanks {\n  text-align: center;\n  font-size: 6pt;\n  direction: rtl;\n  margin-top: 1.5mm;\n  line-height: 1.5;\n}\n\n.footer-date {\n  text-align: center;\n  font-size: 5.5pt;\n  color: #444;\n  margin-top: 0.5mm;\n  direction: rtl;\n}\n\n/* \u2550\u2550 SCREEN PREVIEW \u2550\u2550 */\n@media screen {\n  html { background: #c0c0c0; padding: 10mm; }\n  body {\n    background: #fff;\n    box-shadow: 0 2px 18px rgba(0,0,0,0.35);\n  }\n}\n\n@media print {\n  html, body { background:#fff; box-shadow:none; padding:0; margin:0; }\n}\n\n</style>\n</head>\n<body>\n\n<!-- \u2550\u2550 HEADER \u2550\u2550 -->\n<div class=\"header\">\n  <!--\n    \u0627\u0633\u062a\u0628\u062f\u0644 div.logo-placeholder \u0628\u0640:\n    <img src=\"logo.png\" style=\"width:30mm;height:auto;display:block;margin:0 auto 1mm auto;\"/>\n  -->\n  <img src=\"{{brand_logo}}\" style=\"width:30mm;height:auto;display:block;margin:0 auto 1mm auto;\"/>\n  <div class=\"company-tagline\">\n    <div class=\"tagline-main\">\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u064a\u062f\u064a\u0627 \u062a\u064a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629</div>\n    <div class=\"tagline-sub\">\u062a\u062c\u0627\u0631\u0629 \u0627\u0643\u0633\u0633\u0648\u0627\u0631\u0627\u062a \u0648\u0645\u0639\u062f\u0627\u062a \u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0648\u0627\u0644\u0644\u0627\u0628\u062a\u0648\u0628</div>\n  </div>\n</div>\n\n<div class=\"sep-dash\"></div>\n\n<!-- \u2550\u2550 META \u2550\u2550 -->\n<div class=\"meta-block\">\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">DATE</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{invoice_date}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">INVOICE NO</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{invoice_number}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">BRANCH</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{branch_name}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">CLIENT</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{customer_name}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">PHONE</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{customer_phone}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">USER</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{username_cashier}}</span>\n  </div>\n</div>\n\n<div class=\"sep-dash\"></div>\n\n<!-- \u2550\u2550 ITEMS TABLE \u2550\u2550 -->\n<table class=\"items-table\">\n  <thead>\n    <tr>\n      <th class=\"col-no\">#</th>\n      <th class=\"col-desc\">DESCRIPTION</th>\n      <th class=\"col-qty\">QTY</th>\n      <th class=\"col-price\">PRICE</th>\n      <th class=\"col-total\">TOTAL</th>\n    </tr>\n  </thead>\n  <tbody>\n    {{ITEMS_ROWS}}\n  </tbody>\n</table>\n\n<div class=\"sep-dash\"></div>\n\n<!-- \u2550\u2550 TOTALS \u2550\u2550 -->\n<div class=\"totals-block\">\n  <div class=\"totals-row\">\n    <span class=\"t-label\">SUBTOTAL</span>\n    <span class=\"t-value\">{{subtotal}}</span>\n  </div>\n  <div class=\"totals-row\">\n    <span class=\"t-label\">DISCOUNT</span>\n    <span class=\"t-value\">{{discount}}</span>\n  </div>\n  <div class=\"totals-row\">\n    <span class=\"t-label\">TAX ({{tax_rate}}%)</span>\n    <span class=\"t-value\">{{tax}}</span>\n  </div>\n</div>\n\n<div class=\"sep-dash\"></div>\n\n<div class=\"grand-total-row\">\n  <span>TOTAL</span>\n  <span>{{grand_total}}</span>\n</div>\n\n<div class=\"sep-double\"></div>\n\n<!-- \u2550\u2550 ALERT BOX \u2550\u2550 -->\n<div class=\"alert-box\">\n  &#9651; \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0642\u0637\u0639\u0629 \u0645\u0634\u0645\u0648\u0644\u0629 \u0628\u0627\u0644\u0636\u0645\u0627\u0646\u060c \u0641\u0633\u062a\u062c\u062f \u0628\u0637\u0627\u0642\u0629 \u0636\u0645\u0627\u0646 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0631\u0645\u0632 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0633\u0631\u064a\u0639 (QR) \u0645\u0631\u0641\u0642\u0629 \u0645\u0639\u0647\u0627.\n</div>\n\n<!-- \u2550\u2550 NOTES \u2550\u2550 -->\n<div class=\"notes-section\">\n  <div class=\"notes-header\">\n    <span class=\"notes-label-ar\">\u0645\u0644\u0627\u062d\u0638\u0627\u062a</span>\n    <span class=\"notes-placeholder\">{{notes}}</span>\n  </div>\n  <div class=\"notes-body\">&#8203;</div>\n</div>\n\n\n\n<!-- \u2550\u2550 QR \u2014 \u0639\u0645\u0648\u062f\u064a\u060c \u0643\u0644 QR \u0628\u062c\u0627\u0646\u0628 \u0646\u0635\u0647 \u2550\u2550 -->\n<div class=\"qr-section\">\n\n  <!-- QR \u0627\u0644\u0645\u0648\u0642\u0639 -->\n  <div class=\"qr-item\">\n    <div class=\"qr-item-text\">\n      <div class=\"qr-item-title\">&#127760; \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a</div>\n      <div class=\"qr-item-desc\">\u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0639\u0631\u0648\u0636\u060c \u062a\u0641\u0636\u0644 \u0628\u0632\u064a\u0627\u0631\u0629 \u0645\u0648\u0642\u0639\u0646\u0627 \u0623\u0648 \u0645\u062a\u062c\u0631\u0646\u0627 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a. \u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0636\u0645\u0627\u0646 \u0628\u0625\u062f\u062e\u0627\u0644 \u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629.</div>\n    </div>\n    <div class=\"qr-img-box\"><img src=\"{{website_qr}}\" style=\"width:13mm;height:13mm;display:block;\"/></div>\n  </div>\n\n  <!-- QR \u0643\u0648\u0628\u0648\u0646 -->\n  <div class=\"qr-item\">\n    <div class=\"qr-item-text\">\n      <div class=\"qr-item-title\">&#127915; \u0643\u0648\u0628\u0648\u0646 \u062e\u0635\u0645</div>\n      <div class=\"qr-item-desc\">\u0627\u0645\u0633\u062d \u0627\u0644\u0628\u0627\u0631\u0643\u0648\u062f \u0627\u0644\u0622\u0646 \u0648\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u062e\u0635\u0645 \u0639\u0644\u0649 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0623\u0648 \u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0643\u0631\u064a\u062f\u062a \u0644\u0639\u0645\u0644\u064a\u0627\u062a\u0643 \u0627\u0644\u0642\u0627\u062f\u0645\u0629\u060c \u0648\u0641\u0642 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645.</div>\n    </div>\n    <div class=\"qr-img-box\"><img src=\"{{coupon_qr}}\" style=\"width:13mm;height:13mm;display:block;\"/></div>\n  </div>\n\n</div>\n\n<!-- \u2550\u2550 MANAGEMENT \u2550\u2550 -->\n<div class=\"management-row\">\n  \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0648\u0627\u0644\u0634\u0643\u0627\u0648\u0649 \u0648\u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 | \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 : {{management_phone}}\n</div>\n\n<!-- \u2550\u2550 FOOTER \u2550\u2550 -->\n<div class=\"footer-thanks\">\n  \u0634\u0643\u0631\u0627\u064b \u0644\u0627\u062e\u062a\u064a\u0627\u0631\u0643\u0645 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u064a\u062f\u064a\u0627 \u062a\u064a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629\n</div>\n<div class=\"footer-date\">\n  \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629: {{print_date}}\n</div>\n\n</body>\n</html>\n";
+var TEMPLATE_CANON = "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>Invoice {{invoice_number}}</title>\n<style>\n\n* { margin:0; padding:0; box-sizing:border-box; }\n\n@page {\n  size: 70mm auto;\n  margin: 0;\n}\n\n/*\n  \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0639\u0631\u0636\u0647\u0627 ~740px \u062a\u0642\u0631\u064a\u0628\u0627\u064b\n  \u0646\u0633\u0628\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644: 70mm / 740px \u2248 0.0945mm/px\n  \u0627\u0644\u062e\u0637\u0648\u0637 \u0648\u0627\u0644\u0647\u0648\u0627\u0645\u0634 \u0645\u0642\u0633\u0648\u0645\u0629 \u0639\u0644\u0649 2 \u0645\u0646 \u0627\u0644\u0623\u0635\u0644\n  font-size \u0623\u0635\u0644\u064a \u0641\u064a \u0627\u0644\u0635\u0648\u0631\u0629 \u2248 14-16px \u2192 \u00f72 = 7-8px \u2192 ~5.5-6pt \u0639\u0644\u0649 70mm\n*/\n\nbody {\n  font-family: 'Courier New', Courier, monospace;\n  font-size: 6pt;\n  color: #000;\n  background: #fff;\n  width: 70mm;\n  max-width: 70mm;\n  margin: 0 auto;\n  padding: 1.5mm 2.5mm;\n  overflow: hidden;\n}\n\n/* \u0645\u0646\u0639 \u0627\u0644\u062a\u062c\u0627\u0648\u0632 \u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 */\ndiv, span, td, th, p {\n  overflow-wrap: break-word;\n  word-break: break-word;\n  max-width: 100%;\n}\n\n/* \u2550\u2550 HEADER \u2550\u2550 */\n.header {\n  text-align: center;\n  padding-bottom: 1mm;\n}\n\n/* \u0644\u0648\u063a\u0648 placeholder \u2014 \u0627\u0633\u062a\u0628\u062f\u0644\u0647 \u0628\u0640 img \u0639\u0646\u062f \u0627\u0644\u062a\u0648\u0641\u0631 */\n.logo-placeholder {\n  width: 50mm;\n  height: 22mm;\n  border: 0.5px dashed #bbb;\n  margin: 0 auto 1mm auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 5pt;\n  color:#5b6472;\n}\n\n.company-tagline {\n  direction: rtl;\n  text-align: center;\n}\n\n.tagline-main {\n  font-size: 6.5pt;\n  font-weight: bold;\n  line-height: 1.5;\n}\n\n.tagline-sub {\n  font-size: 5.5pt;\n  font-weight: normal;\n  line-height: 1.5;\n}\n\n/* \u2550\u2550 SEPARATORS \u2550\u2550\n   \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629: \u062e\u0637\u0648\u0637 dashed \u0648\u0627\u0636\u062d\u0629\n   \u00f72 \u2192 \u0646\u0628\u0642\u064a\u0647\u0627 1px \u0644\u0623\u0646\u0647\u0627 \u0644\u0627 \u062a\u062a\u062c\u0632\u0623\n*/\n.sep-dash {\n  border: none;\n  border-top: 1px dashed #000;\n  margin: 1.5mm 0;\n}\n.sep-solid {\n  border: none;\n  border-top: 1px solid #000;\n  margin: 1mm 0;\n}\n.sep-double {\n  border-top: 2px double #000;\n  margin: 1mm 0;\n}\n\n/* \u2550\u2550 META BLOCK \u2550\u2550\n   label width \u0623\u0635\u0644\u064a ~90px \u2192 \u00f72 \u2248 4.5mm \u2192 \u0646\u0633\u062a\u062e\u062f\u0645 16mm \u0644\u0645\u0631\u0627\u0639\u0627\u0629 \u0627\u0644\u062e\u0637 \u0627\u0644\u0635\u063a\u064a\u0631\n*/\n.meta-block {\n  width: 100%;\n  font-size: 6pt;\n  line-height: 1.7;\n}\n\n.meta-row {\n  display: flex;\n  width: 100%;\n}\n\n.meta-label {\n  font-weight: bold;\n  width: 16mm;\n  flex-shrink: 0;\n  white-space: nowrap;\n}\n\n.meta-colon {\n  width: 3mm;\n  flex-shrink: 0;\n  text-align: center;\n}\n\n.meta-value {\n  flex: 1;\n  word-break: break-word;\n  overflow-wrap: break-word;\n}\n\n.meta-value.rtl {\n  direction: rtl;\n  text-align: right;\n}\n\n/* \u2550\u2550 ITEMS TABLE \u2550\u2550\n   \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0639\u0631\u0636 ~740px \u062f\u0627\u062e\u0644\u064a:\n   #    : ~40px  \u2192 \u00f72 \u2248 2mm  \u2192 4mm\n   DESC : ~320px \u2192 \u00f72 \u2248 15mm \u2192 22mm\n   QTY  : ~80px  \u2192 \u00f72 \u2248 4mm  \u2192 7mm\n   PRICE: ~130px \u2192 \u00f72 \u2248 6mm  \u2192 11mm\n   TOTAL: ~130px \u2192 \u00f72 \u2248 6mm  \u2192 11mm\n   \u0645\u062c\u0645\u0648\u0639: 55mm \u062f\u0627\u062e\u0644 padding 2.5mm*2=5mm \u2192 70-5=65mm \u2713\n*/\n.items-table {\n  width: 65mm;\n  border-collapse: collapse;\n  table-layout: fixed;\n}\n\n.items-table thead th {\n  font-weight: bold;\n  font-size: 6pt;\n  padding: 1mm 0.4mm;\n  border-top: 1px dashed #000;\n  border-bottom: 1px dashed #000;\n  text-align: left;\n}\n\n.items-table tbody td {\n  font-size: 5.5pt;\n  padding: 0.8mm 0.4mm;\n  vertical-align: top;\n  overflow-wrap: break-word;\n  word-break: break-word;\n}\n\n.col-no    { width: 4mm;  }\n.col-desc  { width: 22mm; }\n.col-qty   { width: 7mm;  text-align: center; }\n.col-price { width: 11mm; text-align: right;  }\n.col-total { width: 11mm; text-align: right;  }\n\n.items-table thead th.col-qty   { text-align: center; }\n.items-table thead th.col-price { text-align: right;  }\n.items-table thead th.col-total { text-align: right;  }\n\n/* \u2550\u2550 TOTALS \u2550\u2550 */\n.totals-block {\n  width: 100%;\n  font-size: 6pt;\n  line-height: 1.75;\n}\n\n.totals-row {\n  display: flex;\n  justify-content: space-between;\n}\n\n.totals-row .t-label { font-weight: bold; }\n.totals-row .t-value { text-align: right; min-width: 16mm; }\n\n/* \u2550\u2550 GRAND TOTAL \u2550\u2550\n   \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 TOTAL \u0628\u062e\u0637 \u0643\u0628\u064a\u0631 ~22px \u2192 \u00f72 \u2248 8pt\n*/\n.grand-total-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 8.5pt;\n  font-weight: bold;\n  padding: 0.8mm 0;\n}\n\n/* \u2550\u2550 ALERT BOX \u2550\u2550 */\n.alert-box {\n  border: none;\n  border-top: 1px dashed #000;\n  border-bottom: 1px dashed #000;\n  padding: 0.8mm 0;\n  margin: 1mm 0;\n  font-size: 4.8pt;\n  font-weight: bold;\n  line-height: 1.5;\n  white-space: nowrap;\n  text-align: right;\n  direction: rtl;\n  line-height: 1.3;\n  white-space: normal;\n  overflow: hidden;\n}\n\n/* \u2550\u2550 NOTES \u2550\u2550 */\n.notes-section {\n  border: none;\n  border-top: 1px dashed #888;\n  border-bottom: 1px dashed #888;\n  margin-bottom: 1.5mm;\n}\n\n.notes-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.8mm 1.5mm;\n  border-bottom: 1px solid #ccc;\n  direction: rtl;\n}\n\n.notes-label-ar   { font-weight: bold; font-size: 6pt; }\n.notes-placeholder { font-size: 6pt; color: #555; direction: ltr; }\n\n.notes-body {\n  padding: 1mm 1.5mm;\n  min-height: 5mm;\n  font-size: 6pt;\n  direction: rtl;\n  text-align: right;\n}\n\n/* \u2550\u2550 USER INFO \u2550\u2550 */\n.user-info-row {\n  text-align: right;\n  direction: rtl;\n  font-size: 6pt;\n  margin-bottom: 1.5mm;\n  line-height: 1.6;\n}\n\n/* \u2550\u2550 QR SECTION \u2550\u2550 */\n.qr-section {\n  width: 100%;\n  margin: 1mm 0;\n}\n\n.qr-item {\n  border: none;\n  border-top: 1px dashed #888;\n  border-bottom: 1px dashed #888;\n  padding: 1mm;\n  margin-bottom: 1.5mm;\n  display: flex;\n  flex-direction: row-reverse;\n  align-items: center;\n  gap: 1.5mm;\n}\n\n.qr-item-text {\n  flex: 1;\n  direction: rtl;\n  text-align: right;\n  min-width: 0;\n  overflow: hidden;\n}\n\n.qr-item-title {\n  font-size: 5pt;\n  font-weight: bold;\n  margin-bottom: 0.5mm;\n  line-height: 1.3;\n}\n\n.qr-item-desc {\n  font-size: 4.2pt;\n  line-height: 1.4;\n  color: #333;\n}\n\n.qr-img-box {\n  width: 13mm;\n  height: 13mm;\n  border: 1px dashed #aaa;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 4pt;\n  color:#5b6472;\n  text-align: center;\n}\n\n/* \u2550\u2550 MANAGEMENT \u2550\u2550 */\n.management-row {\n  text-align: center;\n  font-size: 3pt;\n  direction: rtl;\n  border-top: 1px solid #ccc;\n  padding-top: 1.2mm;\n  margin-top: 1mm;\n  line-height: 1.5;\n  overflow: hidden;\n}\n\n/* \u2550\u2550 FOOTER \u2550\u2550 */\n.footer-thanks {\n  text-align: center;\n  font-size: 6pt;\n  direction: rtl;\n  margin-top: 1.5mm;\n  line-height: 1.5;\n}\n\n.footer-date {\n  text-align: center;\n  font-size: 5.5pt;\n  color: #444;\n  margin-top: 0.5mm;\n  direction: rtl;\n}\n\n/* \u2550\u2550 SCREEN PREVIEW \u2550\u2550 */\n@media screen {\n  html { background: #c0c0c0; padding: 10mm; }\n  body {\n    background: #fff;\n    box-shadow: 0 2px 18px rgba(0,0,0,0.35);\n  }\n}\n\n@media print {\n  html, body { background:#fff; box-shadow:none; padding:0; margin:0; }\n}\n\n</style>\n</head>\n<body>\n\n<!-- \u2550\u2550 HEADER \u2550\u2550 -->\n<div class=\"header\">\n  <!--\n    \u0627\u0633\u062a\u0628\u062f\u0644 div.logo-placeholder \u0628\u0640:\n    <img src=\"logo.png\" style=\"width:30mm;height:auto;display:block;margin:0 auto 1mm auto;\"/>\n  -->\n  <img src=\"{{brand_logo}}\" style=\"width:30mm;height:auto;display:block;margin:0 auto 1mm auto;\"/>\n  <div class=\"company-tagline\">\n    <div class=\"tagline-main\">\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u064a\u062f\u064a\u0627 \u062a\u064a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629</div>\n    <div class=\"tagline-sub\">\u062a\u062c\u0627\u0631\u0629 \u0627\u0643\u0633\u0633\u0648\u0627\u0631\u0627\u062a \u0648\u0645\u0639\u062f\u0627\u062a \u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0648\u0627\u0644\u0644\u0627\u0628\u062a\u0648\u0628</div>\n  </div>\n</div>\n\n<div class=\"sep-dash\"></div>\n\n<!-- \u2550\u2550 META \u2550\u2550 -->\n<div class=\"meta-block\">\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">DATE</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{invoice_date}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">INVOICE NO</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{invoice_number}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">BRANCH</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{branch_name}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">CLIENT</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{customer_name}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">PHONE</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{customer_phone}}</span>\n  </div>\n  <div class=\"meta-row\">\n    <span class=\"meta-label\">USER</span>\n    <span class=\"meta-colon\">:</span>\n    <span class=\"meta-value\">{{username_cashier}}</span>\n  </div>\n</div>\n\n<div class=\"sep-dash\"></div>\n\n<!-- \u2550\u2550 ITEMS TABLE \u2550\u2550 -->\n<table class=\"items-table\">\n  <thead>\n    <tr>\n      <th class=\"col-no\">#</th>\n      <th class=\"col-desc\">DESCRIPTION</th>\n      <th class=\"col-qty\">QTY</th>\n      <th class=\"col-price\">PRICE</th>\n      <th class=\"col-total\">TOTAL</th>\n    </tr>\n  </thead>\n  <tbody>\n    {{ITEMS_ROWS}}\n  </tbody>\n</table>\n\n<div class=\"sep-dash\"></div>\n\n<!-- \u2550\u2550 TOTALS \u2550\u2550 -->\n<div class=\"totals-block\">\n  <div class=\"totals-row\">\n    <span class=\"t-label\">SUBTOTAL</span>\n    <span class=\"t-value\">{{subtotal}}</span>\n  </div>\n  <div class=\"totals-row\">\n    <span class=\"t-label\">DISCOUNT</span>\n    <span class=\"t-value\">{{discount}}</span>\n  </div>\n  <div class=\"totals-row\">\n    <span class=\"t-label\">TAX ({{tax_rate}}%)</span>\n    <span class=\"t-value\">{{tax}}</span>\n  </div>\n</div>\n\n<div class=\"sep-dash\"></div>\n\n<div class=\"grand-total-row\">\n  <span>TOTAL</span>\n  <span>{{grand_total}}</span>\n</div>\n\n<div class=\"sep-double\"></div>\n\n<!-- \u2550\u2550 ALERT BOX \u2550\u2550 -->\n<div class=\"alert-box\">\n  &#9651; \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0642\u0637\u0639\u0629 \u0645\u0634\u0645\u0648\u0644\u0629 \u0628\u0627\u0644\u0636\u0645\u0627\u0646\u060c \u0641\u0633\u062a\u062c\u062f \u0628\u0637\u0627\u0642\u0629 \u0636\u0645\u0627\u0646 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0631\u0645\u0632 \u0627\u0633\u062a\u062c\u062