+/* ══ حذفٌ مُتحقَّق (2026-10-11 · مع بوّابة الصلاحية السيادية) ══
+   الجذر: PostgREST يردّ 204 «ناجحاً» حتى لو لم يُحذف أيّ صفّ (سياسة RLS، أو حُذف من جهازٍ آخر) ⇒ كانت الصفحة تقول
+   «تم حذف الطلب» والقاعدة لم تتغيّر. هنا نطلب الصفوف المحذوفة نفسها (return=representation) ونعدّها.
+   بلا اتصال ⇒ طابور GMTSync كالسابق (يُرسَل عند العودة) ونُعيد 'queued' كي تقولها الواجهة صراحةً لا «تمّ».
+   يرجع 'deleted' | 'queued'، ويرمي خطأً عربياً واضحاً إن لم يُحذف شيء. */
+async function sbDeleteVerified(table, id) {
+    const offline = (navigator.onLine === false) || (window.GMTSync && GMTSync.isTemp && GMTSync.isTemp(id));
+    if (offline) {
+        if (table !== TABLE) throw new Error('لا اتصال بالإنترنت — لم يُحذف شيء، أعد المحاولة بعد عودة الاتصال');
+        await sbDelete(id); return 'queued';
+    }
+    const rid = (window.GMTSync && GMTSync.realId) ? GMTSync.realId(id) : id;
+    let r;
+    try {
+        r = await fetch(`${SUPA_URL}/rest/v1/${table}?id=eq.${encodeURIComponent(rid)}`, {
+            method: 'DELETE', headers: { ...SB_HEADERS, Prefer: 'return=representation' }
+        });
+    } catch (e) {
+        /* انقطاعٌ لحظة الإرسال: الأوردر يدخل طابور المزامنة، والحجز لا (لا طابور له) */
+        if (table === TABLE) { await sbDelete(id); return 'queued'; }
+        throw new Error('تعذّر الاتصال — لم يُحذف شيء');
+    }
+    if (!r.ok) throw new Error('HTTP ' + r.status + ' — ' + (await r.text().catch(() => '')).slice(0, 120));
+    const rows = await r.json().catch(() => null);
+    if (!Array.isArray(rows) || !rows.length) {
+        const e = new Error('القاعدة لم تحذف أيّ سجلّ (غالباً لا صلاحية، أو حُذف من جهازٍ آخر)'); e.code = 'ZERO'; throw e;
+    }
+    return 'deleted';
+}
+/* يكتب «مَن فوّض ولماذا» على نسخة السلّة (gmt_trash تُنسخ عند طبقة الشبكة في gmt-account.js قبل أن يعود الحذف).
+   أفضل جهد: إن لم يُشغَّل SQL السلّة بعد فلا شيء يفشل — السطر نفسه محفوظ في سجلّ العمليات (sov_authorized). */
+async function noteTrashGrant(table, id, grant) {
+    if (!grant) return;
+    try {
+        const actor = (typeof getOperatorName === 'function' && getOperatorName()) || '';
+        const txt = (actor ? actor + ' · ' : '') + 'فوّض: ' + grant.by + (grant.via === 'sovereign_pw' ? '' : ' (أدمن)') + ' · السبب: ' + grant.reason;
+        await fetch(`${SUPA_URL}/rest/v1/gmt_trash?tbl=eq.${table}&row_id=eq.${encodeURIComponent(String(id))}&restored_at=is.null`, {
+            method: 'PATCH', headers: { ...SB_HEADERS, Prefer: 'return=minimal' }, body: JSON.stringify({ deleted_by: txt.slice(0, 300) })
+        });
+    } catch (_) {}
+}
