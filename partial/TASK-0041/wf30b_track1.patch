+    }
+    if (S.on === null) { await g.GMTAsk.alert('تعذّر قراءة حالة القفل الآن (' + (S.err || 'لا اتصال') + '). لن نغيّر شيئاً قبل أن نعرف الحالة الفعلية — أعد المحاولة بعد عودة الاتصال.', { title: 'قفل الأوردرات', icon: 'danger' }); return; }
